<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRecibo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Fila superior: miniatura + datos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Miniatura de la factura -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgRecibo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@color/surface_variant"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
                tools:src="@android:drawable/ic_menu_report_image" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Título + correlativo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTituloRecibo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        tools:text="Compra Supermercado" />

                    <TextView
                        android:id="@+id/tvIdRecibo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:background="#E3EEFA"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:paddingVertical="@dimen/space_xs"
                        android:text="#0"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/brand_blue"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Categoría con color propio -->
                <TextView
                    android:id="@+id/tvCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/brand_green"
                    android:textStyle="bold"
                    tools:text="Gasolina" />

                <!-- Fecha y total -->
                <TextView
                    android:id="@+id/tvFechaRecibo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="Fecha: 03/11/2026   ·   L. 0.00"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Separador sutil -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/outline" />

        <!-- Acciones: texto + icono, con área táctil de 48dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerRecibo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="Ver"
                android:textAllCaps="false"
                android:textColor="@color/brand_primary"
                app:icon="@android:drawable/ic_menu_view"
                app:iconTint="@color/brand_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarRecibo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="Editar"
                android:textAllCaps="false"
                android:textColor="@color/brand_blue"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="@color/brand_blue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarRecibo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:text="Borrar"
                android:textAllCaps="false"
                android:textColor="@color/brand_danger"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconTint="@color/brand_danger" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
