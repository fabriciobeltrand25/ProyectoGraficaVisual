
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AutoScan Hn"
            android:textColor="#12345A"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control inteligente de gastos vehiculares"
            android:textColor="#718096"
            android:textSize="14sp"
            android:layout_marginBottom="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LECTURA DE RECIBOS"
            android:textColor="#12345A"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnEscanear"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Escanear Recibo (Cámara)"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#12345A"/>

        <Button
            android:id="@+id/btnGaleria"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="Cargar de Galería"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#1976D2"/>

        <Button
            android:id="@+id/btnLivePreview"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:text="Live Preview - Tiempo Real"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#16845B"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DCE3EC"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="22dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ÚLTIMO GASTO REGISTRADO"
            android:textColor="#12345A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="3dp">

            <TextView
                android:id="@+id/txtUltimoTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="L. 0.00"
                android:textColor="#16845B"
                android:textSize="30sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtUltimosLitros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Combustible: -- litros"
                android:textColor="#526174"
                android:textSize="15sp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/txtUltimaFecha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha: --"
                android:textColor="#526174"
                android:textSize="15sp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
