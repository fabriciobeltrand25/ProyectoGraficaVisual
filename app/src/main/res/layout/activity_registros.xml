<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- TÍTULO Y BOTÓN DE RETROCESO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAtrasRegistros"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="-12dp"
            android:contentDescription="Volver"
            app:icon="@android:drawable/ic_menu_revert"
            app:iconSize="24dp"
            app:iconTint="@color/brand_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="Registros"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/brand_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- BUSCADOR -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:hint="Buscar por nombre o correlativo"
        app:boxBackgroundColor="@color/surface"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="@color/text_hint"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuscadorRecibos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- FILTRO DE CATEGORÍAS -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_md"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategorias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/space_sm"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodas"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Todas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGasolina"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gasolina" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMantenimiento"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mantenimiento" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- LISTA (con aviso cuando no hay registros) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRegistrosRecibos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_lg"
            android:scrollbars="none"
            tools:listitem="@layout/item_card_recibo" />

        <TextView
            android:id="@+id/txtVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Aún no hay registros.\nEscanea tu primera factura desde Inicio."
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
